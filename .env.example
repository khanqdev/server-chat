# Copy file này thành .env rồi điền giá trị thật.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/chat_server?appName=Cluster0

# Base64, tối thiểu 256 bit. Tạo bằng: openssl rand -base64 64
JWT_SECRET=
# Access token: 15 phút. Refresh token: 7 ngày
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# Google OAuth Client ID (Google Cloud Console > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=

# SMTP gửi OTP. Để trống MAIL_HOST thì OTP chỉ được in ra log (chỉ dùng khi dev)
# Gmail: MAIL_HOST=smtp.gmail.com, MAIL_PASSWORD là App Password 16 ký tự
MAIL_HOST=
MAIL_PORT=465
# true cho cổng 465 (SSL), false cho cổng 587 (STARTTLS)
MAIL_SSL_ENABLE=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# Chặn spam request. PHẢI đặt RATE_LIMIT_SKIP_LOCALHOST=false khi chạy production
RATE_LIMIT_ENABLED=true
RATE_LIMIT_SKIP_LOCALHOST=true
RATE_LIMIT_GENERAL_PER_MINUTE=60
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_REGISTER_PER_HOUR=3
RATE_LIMIT_OTP_VERIFY_PER_HOUR=10
